# /opt/stack/traefik/dynamic/einlass.yml
#
# DIESE DATEI IST EIN BEISPIEL. Die echte heisst einlass.yml, steht NICHT im
# Git (CLAUDE.md §21) und enthaelt ein Geheimnis.
#
# Wozu (N-44): Die Identitaet eines Aufrufers kommt als Kopfzeile von
# Traefik. Ein Werkzeug kann aber nicht sehen, WOHER eine Anfrage kam - nur,
# was drinsteht. Im Docker-Netz erreicht jeder Container Port 8080 eines
# anderen direkt, ohne Traefik und ohne Anmeldung. Wer das kann, koennte
# sich jede Gruppe geben, die er will.
#
# Darum setzt Traefik am Eingang eine Marke, die nur er und die Werkzeuge
# kennen. Ohne sie antwortet ein Werkzeug gar nicht erst.
#
# ANLEGEN - ein Befehl, beliebig oft aufrufbar (N-96, N-67):
#
#   sudo prolo geheimnisse --verteilen
#
# Er wuerfelt den Wert, schreibt ihn hierher UND in die .env jedes
# Werkzeugs, das ihn prueft (welche das sind, sagt deren geheimnisse.conf),
# und startet danach, was laeuft, neu - erst Traefik, dann die Werkzeuge.
# Ein vorhandener Wert bleibt stehen. "sudo prolo einrichten" ruft ihn auf
# einem neuen Server von selbst auf.
#
# Die Reihenfolge ist wichtig, und der Befehl haelt sie ein: startet ein
# Werkzeug vor Traefik mit dem neuen Wert, kommen die Anfragen mit der
# alten Marke an und es antwortet mit 401 - bis Traefik nachzieht. Ohne
# den Wert in seiner .env startet ein Werkzeug ueberhaupt nicht und sagt
# im Protokoll, was fehlt.
#
# VON HAND, nur wenn der Befehl nicht geht (der Wert ist ein Geheimnis wie
# ein Passwort - nicht in Git, nicht in einen Chat, §21/§22):
#   1. openssl rand -base64 33
#   2. sudo cp einlass.yml.beispiel einlass.yml, den Platzhalter unten
#      ersetzen, dann: sudo chown root:root einlass.yml && sudo chmod 600 einlass.yml
#   3. denselben Wert als PROLO_EINLASS=<wert> in die .env jedes Werkzeugs
#   4. erst Traefik, dann die Werkzeuge:
#        sudo prolo start traefik
#        sudo prolo start <werkzeug>
#
# WECHSELN:  sudo prolo geheimnisse --neu
# Er fragt nach, legt einen Merkzettel mit altem und neuem Wert an und
# haelt dieselbe Reihenfolge ein. Dazwischen liegen ein paar Sekunden 401 -
# das ist der Preis und kein Datenverlust.

http:
  middlewares:
    einlass:
      headers:
        customRequestHeaders:
          X-Prolo-Einlass: "HIER-EINEN-GEWUERFELTEN-WERT-EINTRAGEN"
