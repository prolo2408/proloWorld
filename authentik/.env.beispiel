# /opt/stack/authentik/.env  -  NIE in Git. Kopie in den Passwortmanager.
#
# Authentik ist die Anmeldung fuer den ganzen Stack. Faellt sie aus, kommt
# niemand mehr in irgendein Werkzeug. Beide Werte hier sind darum keine
# Einstellung, sondern der Schluessel zur Haustuer.

# Signiert Sitzungen und Token. Nach einem Wechsel muss sich jeder neu
# anmelden - es gehen aber keine Daten verloren.
# Wuerfeln mit:  openssl rand -base64 33
AUTHENTIK_SECRET_KEY=

# Das Datenbankpasswort. ACHTUNG: es steht nicht nur hier, sondern AUCH
# in PostgreSQL selbst. Wer nur diese Zeile aendert, sperrt Authentik aus
# seiner eigenen Datenbank aus - und damit den ganzen Stack aus der
# Anmeldung. "prolo geheimnisse --neu" fasst diesen Wert darum nicht an.
# Beim ERSTEN Aufsetzen ist das egal: die Datenbank entsteht mit genau
# diesem Wert. Wuerfeln mit:  openssl rand -base64 33
PG_PASS=

# Datenbankname und Benutzer. Nur aendern, bevor die Datenbank das erste
# Mal angelegt wird - danach muesste sie umgezogen werden.
PG_DB=authentik
PG_USER=authentik

# Fassung des Abbilds. Feste Nummer, nie "latest" (CLAUDE.md §19).
# Sie steht auch in der docker-compose.yml als Vorgabe; hier laesst sie
# sich fuer einen Versuch umstellen, ohne die Datei zu aendern.
AUTHENTIK_TAG=2026.8.2
