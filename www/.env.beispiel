# /opt/stack/www/.env  -  NIE in Git. Kopie in den Passwortmanager.

# Die Marke der Vertrauensgrenze (N-44). DERSELBE Wert wie in
# /opt/stack/traefik/dynamic/einlass.yml. Ohne ihn startet das Werkzeug
# nicht - und aus ihm wird auch der Schluessel fuer die Sitzungsplaetzchen
# abgeleitet. Wechselt der Wert, laufen alle offenen Zugaenge ab.
# Wuerfeln mit:  openssl rand -base64 33
PROLO_EINLASS=

# Wer die Verwaltung oeffnen darf. Die Gruppe kommt aus Authentik.
WWW_ADMIN_GRUPPE=stack-admin

# Groesste Datei, die abgelegt werden darf.
WWW_MAX_UPLOAD_B=20971520
