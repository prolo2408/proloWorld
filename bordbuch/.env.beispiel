# /opt/stack/bordbuch/.env  -  NIE in Git. Kopie in den Passwortmanager.

# Die Marke der Vertrauensgrenze (N-44). DERSELBE Wert wie in
# /opt/stack/traefik/dynamic/einlass.yml. Ohne ihn startet das Bordbuch
# nicht - im Docker-Netz koennte sich sonst jeder Container als beliebiger
# Nutzer ausgeben.
# Wuerfeln mit:  openssl rand -base64 33
PROLO_EINLASS=
