# /opt/stack/wiki/.env  -  NIE in Git. Kopie in den Passwortmanager.

# Die Marke der Vertrauensgrenze (N-44). DERSELBE Wert wie in
# /opt/stack/traefik/dynamic/einlass.yml. Ohne ihn startet das Wiki nicht.
# Wuerfeln mit:  openssl rand -base64 33
PROLO_EINLASS=

# Authentik-Gruppe, die Seiten einspielen und freigeben darf.
WIKI_ADMIN_GRUPPE=wiki-admin

# Notnagel fuer den ersten Start, solange die Gruppe in Authentik fehlt.
# Danach leeren, damit die Rechte nur noch ueber Authentik laufen.
WIKI_ADMIN_NUTZER=

# Ab dieser Groesse wird ein eingebetteter Base64-Block zum Anhang.
WIKI_ANHANG_SCHWELLE_B=200000

# Groesste Datei, die eingespielt werden darf.
WIKI_MAX_UPLOAD_B=83886080
