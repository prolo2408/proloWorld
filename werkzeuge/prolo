befehl_status() {
  local KURZ=0
  [ "${1:-}" = "--kurz" ] && KURZ=1

  abschnitt "Tools"
  local t ids anz laufend gesund g id
  printf '  %-14s %-10s %-12s %s\n' "TOOL" "CONTAINER" "GESUNDHEIT" "ABBILD"
  for t in $(tools); do
    ids=$(cd "$STACK/$t" && docker compose ps -q 2>/dev/null || true)
    anz=$(printf '%s' "$ids" | grep -c . || true)
    laufend=0; gesund="-"
    local krank=0 startend=0 mit=0
    for id in $ids; do
      [ "$(docker inspect "$id" --format '{{.State.Running}}' 2>/dev/null)" = "true" ] \
        && laufend=$((laufend + 1))
      g=$(docker inspect "$id" \
          --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}ohne{{end}}' 2>/dev/null)
      case "$g" in
        unhealthy) krank=$((krank + 1)); mit=$((mit + 1)) ;;
        starting)  startend=$((startend + 1)); mit=$((mit + 1)) ;;
        healthy)   mit=$((mit + 1)) ;;
      esac
    done
    if   [ "$anz" -eq 0 ];        then gesund="AUS"
    elif [ "$laufend" -lt "$anz" ];then gesund="TEILWEISE"
    elif [ "$krank" -gt 0 ];      then gesund="KRANK"
    elif [ "$startend" -gt 0 ];   then gesund="startet"
    elif [ "$mit" -gt 0 ];        then gesund="gesund"
    else gesund="laeuft"          # ohne eigene Pruefung: mehr wissen wir nicht
    fi
    printf '  %-14s %-10s %-12s %s\n' "$t" "$laufend/$anz" "$gesund" \
      "$(grep -m1 -E '^[[:space:]]*image:' "$STACK/$t/docker-compose.yml" \
         | sed -e 's/^[[:space:]]*image:[[:space:]]*//' -e 's/[[:space:]]*#.*$//')"
  done
  melde ""
  melde "  'laeuft' heisst nur: der Container laeuft. Ohne eigene"
  melde "  Gesundheitspruefung im Abbild ist damit NICHT belegt, dass der"
  melde "  Dienst tut, was er soll."

  if [ "$KURZ" -eq 1 ]; then
    melde ""
    melde "  (--kurz: Namen, Zertifikate, Sicherung und Quellstand"
    melde "   uebersprungen - alles davon braucht das Netz)"
    return 0
  fi

  # --- Namen und Zertifikate -------------------------------------------
  abschnitt "Namen, Ziele und Zertifikate"
  local eigene name ip z tage aus
  eigene=$(curl -s --max-time 10 https://api.ipify.org 2>/dev/null || echo "")
  [ -n "$eigene" ] && melde "  Server-IP: $eigene" || \
    melde "  Server-IP nicht ermittelbar - vergleiche nur die Zertifikate."
  melde ""
  printf '  %-26s %-23s %s\n' "NAME" "ZEIGT AUF" "ZERTIFIKAT"
  # Die Folgerungen werden gesammelt und UNTER der Tabelle ausgegeben -
  # die Tabelle bleibt eine Tabelle, und was zu tun ist, steht am Stueck.
  # Die Arten werden dabei mitgezaehlt, damit die Erklaerung dazu einmal
  # kommt und nicht einmal je Name.
  local folgerungen="" arten="" f art satz wohin zert
  for name in $(hostnamen); do
    ip=$(aufloesen "$name")
    local ipfeld="$ip"
    wohin=hier; zert=keins
    if [ -z "$ip" ]; then ipfeld="KEINE ANTWORT"; wohin=keine
    elif [ -n "$eigene" ] && [ "$ip" != "$eigene" ]; then ipfeld="$ip (FREMD)"; wohin=fremd
    fi
    if z=$(zertifikat "$name"); then
      tage="${z%%|*}"; aus="${z#*|}"
      if [ "$tage" -lt 0 ]; then
        # Abgelaufen ist so gut wie keins - und wird auch so behandelt.
        printf '  %-26s %-23s ABGELAUFEN seit %s Tagen\n' "$name" "$ipfeld" "$(( -tage ))"
      elif [ "$tage" -lt 21 ]; then
        printf '  %-26s %-23s laeuft in %s Tagen ab (%s)\n' "$name" "$ipfeld" "$tage" "$aus"
        zert=ablauf
      elif zertifikat_notbehelf "$aus"; then
        printf '  %-26s %-23s NOTZERTIFIKAT (%s) - kein Let'"'"'s Encrypt\n' \
          "$name" "$ipfeld" "$aus"
        zert=notbehelf
      else
        printf '  %-26s %-23s %s Tage (%s)\n' "$name" "$ipfeld" "$tage" "$aus"
        zert=gut
      fi
    else
      printf '  %-26s %-23s keine Antwort auf 443\n' "$name" "$ipfeld"
    fi
    # Gibt es etwas zu folgern, ist es eine Warnung - und umgekehrt: was
    # hier nichts sagt, war in Ordnung. Zwei Zaehlungen waeren zwei
    # Gelegenheiten, auseinanderzulaufen.
    if f=$(zertifikat_folgerung "$name" "$wohin" "$zert" "$ip" "$eigene"); then
      art=$(printf '%s' "$f" | head -1)
      satz=$(printf '%s' "$f" | tail -n +2)
      folgerungen="$folgerungen$satz
"
      case " $arten " in *" $art "*) ;; *) arten="$arten $art" ;; esac
    fi
  done
  if [ -n "$folgerungen" ]; then
    melde ""
    melde "  Was daraus folgt:"
    melde ""
    printf '%s' "$folgerungen" | sed 's/^/  /'
    for art in $arten; do
      melde ""
      zertifikat_rat "$art" | sed 's/^/  /'
    done
  fi

  abschnitt "Sicherung"
  local M=/opt/backups/.letzter-erfolg
  if [ ! -e "$M" ]; then
    melde "  ACHTUNG: kein Vermerk ueber eine erfolgreiche Sicherung."
  elif [ -n "$(find "$M" -mtime +2 2>/dev/null)" ]; then
    melde "  ACHTUNG: letzte erfolgreiche Sicherung ist aelter als zwei Tage:"
    melde "           $(cat "$M")"
  else
    melde "  letzte erfolgreiche: $(cat "$M")"
  fi

  abschnitt "Quellstand"
  # Eine Zeile aus derselben Pruefung, die auch aktualisieren.sh benutzt
  # (N-38). "Haengt der Stand hinterher?" ist die haeufigste Ursache dafuer,
  # dass eine Aenderung nicht ankommt - das gehoert in den Status, nicht
  # nur in den Aktualisierungslauf.
  if [ -x "$HIER/quellstand.sh" ]; then
    local QZEILE=""
    QZEILE=$("$HIER/quellstand.sh" --kurz) || true
    melde "  $QZEILE"
  else
    melde "  werkzeuge/quellstand.sh fehlt"
  fi

  abschnitt "Archiv"
  if [ -d "$ARCHIV" ] && [ -n "$(ls -A "$ARCHIV" 2>/dev/null)" ]; then
    local a
    for a in "$ARCHIV"/*; do
      [ -d "$a" ] || continue
      melde "  $(basename "$a")  ($(ls "$a"/*.tar.gz 2>/dev/null | grep -vc volume) Stand/Staende)"
    done
  else
    melde "  leer"
  fi
}

# ----------------------------------------------------------------------
befehl_dns() {
  abschnitt "Zeigen die Namen noch hierher?"
  local eigene name ip
  eigene=$(curl -s --max-time 10 https://api.ipify.org 2>/dev/null || echo "")
  if [ -z "$eigene" ]; then
    melde "  Eigene IP nicht ermittelbar - pruefe nur auf Abweichungen."
  else
    melde "  Server-IP: $eigene"
  fi
  melde ""
  local abweichung=0
  for name in $(hostnamen); do
    ip=$(aufloesen "$name")
    if [ -z "$ip" ]; then
      printf '  %-24s %s\n' "$name" "KEINE ANTWORT"; abweichung=1
    elif [ -n "$eigene" ] && [ "$ip" != "$eigene" ]; then
      printf '  %-24s %s  <-- ZEIGT WOANDERS HIN\n' "$name" "$ip"; abweichung=1
    else
      printf '  %-24s %s\n' "$name" "$ip"
    fi
  done
  if [ "$abweichung" -eq 1 ]; then
    melde ""
    melde "  Ein Name, der woanders hinzeigt, ist meist eine DynDNS-Bindung"
    melde "  beim Anbieter: sie ueberschreibt den A-Eintrag bei jedem Update"
    melde "  des Routers. Das Loeschen von API-Schluesseln hilft dagegen"
    melde "  NICHT - die Update-URL traegt ihr Token selbst. Die Bindung"
    melde "  muss beim Anbieter entfernt werden."
    melde ""
    # Was daran haengt, gehoert dazu (N-69). Wer nur "zeigt woanders hin"
    # liest, haelt es fuer eine Kleinigkeit - bis der Browser "Seite ist
    # nicht sicher" sagt und niemand die beiden zusammenbringt.
    melde "  Daran haengt das Zertifikat: Let's Encrypt prueft ueber Port 80"
    melde "  an genau der Adresse, auf die der Name zeigt. Solange das nicht"
    melde "  dieser Server ist, entsteht hier keines, und der Browser meldet"
    melde "  \"Seite ist nicht sicher\"."
    melde "    A-Eintrag auf ${eigene:-die IP dieses Servers} setzen,"
    melde "    danach holt Traefik das Zertifikat von selbst. Sofort"
    melde "    versuchen lassen: sudo prolo start traefik"
    return 1
  fi
}

