#!/bin/bash
# werkzeuge/prolo
#
# Ein Einstiegspunkt fuer den ganzen Stack - wie apt oder docker, nur fuer
# die eigenen Tools.
#
#   prolo status [--kurz]           Tools, Namen, Zertifikate, Sicherung
#   prolo pruefen [tool]            Gesundheit, Zertifikate, DNS
#   prolo aktualisieren [tool|--alle]
#   prolo start|stop|neustart <tool>
#   prolo protokoll <tool> [-f]
#   prolo sichern
#   prolo wiederherstellen [--probe]  einen gesicherten Stand zurueckholen
#   prolo neu <name>                neues Tool anlegen (fragt alles ab)
#   prolo netze [anlegen|schliessen|umziehen]
#   prolo suchen <begriff>          Abbild in der Registry suchen
#   prolo entfernen <tool>          ins Archiv, NICHT loeschen
#   prolo archiv                    was liegt im Archiv
#   prolo zurueckholen <tool> [stand]
#   prolo dns                       zeigen die Namen noch hierher?
#   prolo einrichten [--trocken]    vom frischen Klon zum Stack
#   prolo geheimnisse [--neu|--verteilen|--merkzettel]
#
# Die englischen Namen aus der Anfrage gehen auch: update, healthcheck,
# logs, backup, new, search, remove, archive, restore.
#
# Grundsatz wie bei aktualisieren.sh: im Skript steht KEIN Toolname. Ein
# Tool ist ein Ordner mit docker-compose.yml, alles Tool-eigene steht in
# seinen conf-Dateien.
set -euo pipefail

# Symlinks aufloesen, BEVOR der Ort bestimmt wird.
#
# Der empfohlene Weg ist
#   sudo ln -sf /opt/stack/werkzeuge/prolo /usr/local/bin/prolo
# und genau daran ist die erste Fassung gescheitert: BASH_SOURCE zeigt auf
# den SYMLINK, nicht auf das Ziel. STACK wurde damit /usr/local - keine
# Tools gefunden, kein backup.sh, kein aktualisieren.sh, keine Hostnamen.
# Vier Befehle kaputt, eine Ursache.
QUELLE="${BASH_SOURCE[0]}"
while [ -L "$QUELLE" ]; do
  ZIEL="$(readlink "$QUELLE")"
  case "$ZIEL" in
    /*) QUELLE="$ZIEL" ;;
    *)  QUELLE="$(cd "$(dirname "$QUELLE")" && pwd)/$ZIEL" ;;
  esac
done
HIER="$(cd "$(dirname "$QUELLE")" && pwd)"
STACK="$(dirname "$HIER")"
ARCHIV="$STACK/.archiv"
DOMAENE="${PROLO_DOMAENE:-prolo.me}"

melde()     { printf '%s\n' "$*"; }
abschnitt() { printf '\n\033[1m%s\033[0m\n' "$*"; }
fehler()    { printf '%s\n' "$*" >&2; }

root_noetig() {
  [ "$(id -u)" -eq 0 ] && return 0
  fehler "Dieser Befehl braucht root: sudo prolo $*"
  exit 1
}

tools() {
  local d
  for d in "$STACK"/*/docker-compose.yml; do
    [ -e "$d" ] || continue
    basename "$(dirname "$d")"
  done
}

tool_pruefen_da() {
  [ -f "$STACK/$1/docker-compose.yml" ] && return 0
  fehler "Kein Tool '$1' unter $STACK."
  fehler "Vorhanden: $(tools | tr '\n' ' ')"
  exit 1
}

# Hostnamen aus den Traefik-Regeln lesen - die Wahrheit steht in den Labels,
# nicht in einer zweiten Liste, die veraltet.
hostnamen() {
  # Die Wahrheit steht in den Traefik-Regeln, nicht in einer zweiten Liste,
  # die veraltet. Nicht auf eine Domaene festgelegt - was in einer Regel
  # steht, wird geprueft.
  # Jede Stufe mit "|| true": ein grep ohne Treffer gibt 1 zurueck, und
  # unter set -euo pipefail reisst das die Funktion ab - dann wuerde die
  # Zusatzdatei unten nie gelesen. Genau so ist sie zuerst stumm geblieben.
  #
  # BEIDE Dateien, nicht nur die des Herstellers (N-70): seit N-61 steht
  # bei einem Fremdwerkzeug alles von uns - Netz, Route, Zertifikat - in
  # der docker-compose.override.yml. Wer nur die erste liest, verliert
  # genau die Namen der Werkzeuge, die gerade erst dazugekommen sind, und
  # merkt nichts davon: die Liste wird kuerzer, nicht rot.
  { grep -ho 'Host(`[^`]*`)' \
      "$STACK"/*/docker-compose.yml \
      "$STACK"/*/docker-compose.override.yml 2>/dev/null \
    | sed 's/Host(`//; s/`)//' | sort -u; } || true
  # Dazu Namen, die zum Server gehoeren, aber in keiner Regel stehen -
  # eine Subdomain, die noch eingerichtet wird, oder eine, die jemand
  # versehentlich auf DynDNS gestellt hat. Eine Zeile je Name, # ist ein
  # Kommentar.
  if [ -f "$STACK/werkzeuge/dns-namen.conf" ]; then
    { sed -e 's/#.*//' -e 's/[[:space:]]//g' "$STACK/werkzeuge/dns-namen.conf" \
      | grep -v '^$'; } || true
  fi
  return 0
}

aufloesen() {
  # Die IPv4 zu einem Namen, oder leer.
  #
  # Das "|| true" ist der Kern: getent gibt 2 zurueck, wenn der Name nicht
  # aufloest. Unter set -euo pipefail riss das die aufrufende Funktion ab -
  # und zwar bevor auch nur eine Zeile ausgegeben war. "prolo dns" blieb
  # damit genau dann stumm, wenn ein Name NICHT auflaest, also in dem Fall,
  # fuer den es den Befehl gibt.
  { getent ahostsv4 "$1" 2>/dev/null | awk '{print $1; exit}'; } || true
}

# Zertifikat einer Domaene: Aussteller und Restlaufzeit in Tagen.
# Gibt "<tage>|<aussteller>" oder "" zurueck.
# Wer hat das Zertifikat ausgestellt? Getrennt vom Netzaufruf, damit es
# sich mit festen Eingaben pruefen laesst (N-57).
#
# Die erste Fassung las nur das O=-Feld. Traefiks Notzertifikat hat keines,
# es heisst nur "CN = TRAEFIK DEFAULT CERT" - herausgekommen ist eine leere
# Zeichenkette, und die Warnung "NOTZERTIFIKAT" sucht nach "traefik" darin.
# Sie kam also nie. Angezeigt wurde "364 Tage ()", als waere alles in
# Ordnung. Eine Anzeige, die im Zweifel beruhigt, ist schlimmer als keine.
zertifikat_deuten() {
  local ROH="$1" ENDE AUS
  ENDE=$(printf '%s' "$ROH" | sed -n 's/^notAfter=//p' | head -1)
  [ -n "$ENDE" ] || return 1
  local BIS HEUTE
  BIS=$(date -d "$ENDE" +%s 2>/dev/null) || return 1
  HEUTE=$(date +%s)
  local ZEILE
  ZEILE=$(printf '%s' "$ROH" | sed -n 's/^issuer=//p' | head -1)
  AUS=$(printf '%s' "$ZEILE" | sed -n 's/.*O *= *\([^,]*\).*/\1/p' | head -1)
  [ -n "$AUS" ] || AUS=$(printf '%s' "$ZEILE" | sed -n 's/.*CN *= *\([^,]*\).*/\1/p' | head -1)
  # Leer heisst NICHT "in Ordnung", sondern "nicht erkannt".
  [ -n "$AUS" ] || AUS="unbekannt"
  printf '%s|%s' "$(( (BIS - HEUTE) / 86400 ))" "$AUS"
}

# Ein Herausgeber, der so heisst, ist kein echtes Zertifikat.
zertifikat_notbehelf() {
  printf '%s' "$1" | grep -qiE "traefik|default|unbekannt|localhost|selbst"
}

zertifikat() {
  local NAME="$1" ROH
  ROH=$(echo | timeout 12 openssl s_client -connect "$NAME:443" \
        -servername "$NAME" 2>/dev/null | openssl x509 -noout -enddate -issuer 2>/dev/null) \
        || return 1
  zertifikat_deuten "$ROH"
}

# Was folgt daraus, dass der Name irgendwohin zeigt und das Zertifikat
# so oder so aussieht? (N-69)
#
# Vorher standen beide Tatsachen als zwei Zellen nebeneinander:
#
#   admin.prolo.me    217.160.0.1 (FREMD)   keine Antwort auf 443
#
# und der Fusstext erklaerte FREMD und NOTZERTIFIKAT je fuer sich. Dass
# das eine die URSACHE des anderen ist, stand nirgends - und genau danach
# wurde gefragt: "Ich weiss nicht, was da der Fix ist."
#
# Getrennt vom Netzaufruf, damit es sich mit festen Eingaben pruefen
# laesst (wie zertifikat_deuten, N-57). Gibt 0 zurueck, wenn es etwas zu
# sagen gibt, sonst 1 - wer nichts zu sagen hat, sagt nichts.
#
# Ausgegeben wird die ART in der ersten Zeile und darunter der Satz zu
# DIESEM Namen. Die Erklaerung dazu steht in zertifikat_rat und kommt
# einmal je Art, nicht einmal je Name: zehn Zeilen, die sich bei drei
# Namen dreimal wiederholen, sind nach dem zweiten Mal Tapete (§7).
#
#   $1 Name  $2 wohin: hier|fremd|keine  $3 zertifikat: gut|notbehelf|keins|ablauf
#   $4 gefundene IP  $5 IP dieses Servers
zertifikat_folgerung() {
  local NAME="$1" WOHIN="$2" ZERT="$3" IP="${4:-}" EIGEN="${5:-}"
  local ZIEL="" ZIEL_H="" SOLL="${EIGEN:-die IP dieses Servers}"
  # Zweimal derselbe Sachverhalt, einmal als Nebensatz (Verb ans Ende),
  # einmal als Hauptsatz. Mit nur einer Form kommt an einer der beiden
  # Stellen Kauderwelsch heraus, und eine Meldung, ueber die man
  # stolpert, wird nicht gelesen.
  case "$WOHIN" in
    fremd) ZIEL="auf $IP zeigt und nicht hierher"
           ZIEL_H="zeigt auf $IP und nicht hierher" ;;
    keine) ZIEL="ueberhaupt nicht aufloest"
           ZIEL_H="loest ueberhaupt nicht auf" ;;
  esac

  # Der Fall, um den es geht: kein brauchbares Zertifikat - und der Grund
  # dafuer steht in der Zelle daneben.
  if [ -n "$ZIEL" ] && { [ "$ZERT" = keins ] || [ "$ZERT" = notbehelf ]; }; then
    printf 'dns\n'
    printf '%s hat kein Zertifikat, WEIL der Name %s.\n' "$NAME" "$ZIEL"
    printf '  A-Eintrag fuer %s auf %s setzen.\n' "$NAME" "$SOLL"
    return 0
  fi

  # Der Name zeigt woanders hin, und dort antwortet etwas mit einem
  # gueltigen Zertifikat. Beruhigend sieht das aus und ist es nicht: das
  # Zertifikat ist nicht unseres.
  if [ -n "$ZIEL" ]; then
    printf 'dns\n'
    printf '%s %s - das Zertifikat oben stammt also von dem Server, der\n' "$NAME" "$ZIEL_H"
    printf 'dort antwortet, nicht von diesem hier. Wer %s aufruft,\n' "$NAME"
    printf 'landet nicht bei uns.\n'
    printf '  A-Eintrag fuer %s auf %s setzen.\n' "$NAME" "$SOLL"
    return 0
  fi

  # Ab hier zeigt der Name hierher - als Ursache ist er ausgeschlossen.
  if [ "$ZERT" = keins ] || [ "$ZERT" = notbehelf ]; then
    printf 'acme\n'
    printf '%s zeigt hierher, und trotzdem kommt kein Zertifikat\n' "$NAME"
    printf 'von Let'"'"'s Encrypt. Am Namen liegt es also nicht.\n'
    return 0
  fi

  # Es gibt ein echtes Zertifikat, es laeuft nur bald ab.
  if [ "$ZERT" = ablauf ]; then
    printf 'ablauf\n'
    printf '%s hat ein echtes Zertifikat, das aber bald ablaeuft.\n' "$NAME"
    return 0
  fi

  return 1
}

# Die Erklaerung zu einer Art von Folgerung - einmal, egal wie viele
# Namen betroffen sind. Ebenfalls ohne Netzaufruf, damit sie sich
# einzeln pruefen laesst.
zertifikat_rat() {
  case "$1" in
    dns)
      cat <<ENDE
Let's Encrypt prueft ueber Port 80 an genau der Adresse, auf die der Name
zeigt. Ist das nicht dieser Server, kann hier kein Zertifikat entstehen -
im Browser steht dann "Seite ist nicht sicher".
Zu tun ist es beim DNS-Anbieter, nicht auf dem Server. Steht dort eine
DynDNS-Bindung, muss die zuerst weg: sie ueberschreibt den A-Eintrag bei
jedem Update des Routers, und das Loeschen von API-Schluesseln hilft
dagegen NICHT - die Update-URL traegt ihr Token selbst.
Danach holt Traefik das Zertifikat von selbst, meist in unter einer
Minute. Sofort versuchen lassen:
  sudo prolo start traefik
ENDE
      ;;
    acme)
      cat <<ENDE
Haeufigste Ursache sind die Rechte an acme.json (N-05). Woran es wirklich
liegt, sagt Traefik selbst:
  sudo prolo protokoll traefik
ENDE
      ;;
    ablauf)
      cat <<ENDE
Traefik erneuert bei 30 Tagen Restlaufzeit von selbst. Steht weniger da,
hat das schon einmal nicht geklappt - und warten macht es nicht besser:
  sudo prolo protokoll traefik
ENDE
      ;;
    *) return 1 ;;
  esac
}

