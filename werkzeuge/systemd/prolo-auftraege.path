# werkzeuge/systemd/prolo-auftraege.path  (A-01)
#
# Wacht ueber den Eingang des Auftragsbuchs: sobald die Admin-Seite dort
# einen Auftrag (*.json) ablegt, startet prolo-auftraege.service.
# Installiert von "sudo prolo einrichten" - @STACK@ wird dabei ersetzt.
#
# Nur *.json stoesst an. Die Seite schreibt erst daneben (*.neu) und
# benennt dann um; eine halb geschriebene Datei loest also nichts aus.
[Unit]
Description=Prolo: Auftraege der Admin-Seite abholen

[Path]
PathExistsGlob=@STACK@/admin/auftraege/eingang/*.json
Unit=prolo-auftraege.service

[Install]
WantedBy=multi-user.target
